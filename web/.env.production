# Public defaults for the existing hosted frontend, embedded in browser JavaScript.
# Override in .env.production.local or the Cloudflare build environment.
# Never put credentials or secrets in VITE_* variables.
VITE_AUTH_ORIGIN=https://auth2.scitrera.ai
VITE_WS_ORIGIN=https://wss2.scitrera.ai
VITE_WS_TENANT_PATH=true
# Leave VITE_WS_TRANSPORT unset to retain the browser's transport override.
