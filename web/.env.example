# Development/same-origin example; values are public browser build configuration.
# Production builds load .env.production; override it with .env.production.local.
# Empty origins use the application's origin.
VITE_AUTH_ORIGIN=
VITE_WS_ORIGIN=
VITE_WS_TENANT_PATH=true
VITE_WS_TRANSPORT=websocket
# Optional telemetry; empty means disabled. Never put secrets in VITE_*.
VITE_SENTRY_DSN=
# Server-side development proxies; supply local auth-go and authenticated gateway.
# DEV_AUTH_TARGET=http://127.0.0.1:8080
# DEV_GATEWAY_TARGET=http://127.0.0.1:8081
# DEV_TLS_CERT=/path/to/local.crt
# DEV_TLS_KEY=/path/to/local.key
