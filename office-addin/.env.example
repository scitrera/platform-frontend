# Operator-supplied public application ID (not a client secret).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common/v2.0
VITE_TOOLS_WSS_URL=wss://localhost:8443/v1/connect
# Pass ADDIN_HOST explicitly to npm run build:manifests (it reads process env).
# ADDIN_HOST=https://localhost:3000 npm run build:manifests
# Optional local Office development TLS (export these into the shell).
# DEV_TLS_CERT=/path/to/local.crt
# DEV_TLS_KEY=/path/to/local.key
